# Copy to .env (project root) and edit. Never commit .env.
# Every value can also be set as a real environment variable, which takes precedence over the file.

# ---- core -------------------------------------------------------------------------------
# "development" relaxes some checks (default secret allowed, API docs on, cookies not Secure).
# Anything else is treated as production: SECRET_KEY must be random and >= 32 chars, docs are hidden, cookies are Secure.
ENVIRONMENT=production
# Generate:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=hbfehhjhjbfkjfkfkfakufkkbjfkfjhbjhbbuihuiiuty278y868367898uidbhjbcjvcg
DATABASE_URL=postgresql://neondb_owner:npg_P09wKWfgjLkh@ep-dark-rice-be1j8o3a-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Only used by the automated tests; must name a database ending in _test. Leave empty in production.
TEST_DATABASE_URL=

# ---- encryption at rest -----------------------------------------------------------------
# Comma-separated Fernet keys. The FIRST key encrypts new data; ALL keys can decrypt (key rotation).
# Required outside development. Generate a key:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# LOSING THE KEY MEANS LOSING THE DATA - back it up separately from the database and storage folder.
# To rotate: add a new key at the front, restart, run: python -m scripts.encrypt_existing --rotate
# then remove the old key from the list and restart again.
ENCRYPTION_KEYS=

# ---- web --------------------------------------------------------------------------------
# Comma-separated list of the exact public origin(s) of the web app, e.g. https://pii.example.com
# The cookie endpoints (refresh, logout) refuse browser requests from any other origin, so this MUST match.
CORS_ORIGINS=https://pii.example.com
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10/minute
HEAVY_RATE_LIMIT=60/minute
# URI for the rate-limit store. Default memory:// is fine for a single process. Use redis://host:6379
# to share limits across multiple hosts/processes (gap 5).
RATE_LIMIT_STORAGE_URI=memory://

# ---- accounts ---------------------------------------------------------------------------
# Set false to disable self-registration; use the Admin page (POST /api/v1/users) to create accounts.
ALLOW_REGISTRATION=true
# Lock an account after this many consecutive failed login attempts.
MAX_FAILED_LOGINS=5
# How long (minutes) a locked account stays locked before automatic unlock.
LOCKOUT_MINUTES=15

# ---- files and limits -------------------------------------------------------------------
# Absolute path recommended. Must be private to the app user and backed up together with the database.
STORAGE_DIR=/var/lib/pii-sentinel/storage
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
SCAN_TIMEOUT_SECONDS=120
MAX_EXTRACTED_CHARS=2000000

# ---- retention --------------------------------------------------------------------------
# Delete documents (and their scans, entities, redacted outputs) older than this many days.
# 0 = keep forever (no automatic deletion).
RETENTION_DAYS=0
# Delete audit log rows older than this many days. 0 = keep forever.
AUDIT_RETENTION_DAYS=0
# How often (hours) the retention background loop runs.
RETENTION_INTERVAL_HOURS=6

# ---- OCR --------------------------------------------------------------------------------
OCR_DPI=200
OCR_MIN_TEXT_CHARS=20
# Load OCR and language models in the background at start so the first scan is not slow.
OCR_WARMUP=true

# ---- detection --------------------------------------------------------------------------
# Folder of the fine-tuned model (.../ml/artifacts/pii-minilm-quick/best). Empty = rules-only mode (no PyTorch needed).
NER_MODEL=
# true = never contact the Hugging Face hub (use for air-gapped servers; the fine-tuned folder is self-contained).
NER_LOCAL_ONLY=true
MIN_CONFIDENCE=0.3
NER_MIN_SCORE=0.5
MAX_ENTITIES_PER_SCAN=5000
NER_MAX_CHARS=200000
NER_MAX_LENGTH=256
NER_STRIDE=64
NER_BATCH_SIZE=8
